# Django environment variables
# Railway provides service metadata variables automatically at runtime:
# RAILWAY_PRIVATE_DOMAIN, RAILWAY_PROJECT_NAME, RAILWAY_ENVIRONMENT_NAME,
# RAILWAY_SERVICE_NAME, RAILWAY_PROJECT_ID, RAILWAY_ENVIRONMENT_ID,
# RAILWAY_SERVICE_ID
# You generally only need DATABASE_URL and app-specific vars here.
SECRET_KEY=your-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1
CSRF_TRUSTED_ORIGINS=https://your-app.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.railway.app

# PostgreSQL connection for Railway
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DB_SSLMODE=require

# Brevo SMTP configuration.  Use a verified Brevo sender address and the
# SMTP login/key from Brevo's SMTP & API page.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your_brevo_smtp_user
EMAIL_HOST_PASSWORD=your_brevo_smtp_password
DEFAULT_FROM_EMAIL=your_verified_sender@example.com

# Recommended for Railway: send with Brevo's HTTPS API (port 443) instead of
# SMTP. Generate this separately under Brevo > Settings > SMTP & API > API keys.
BREVO_API_KEY=your_brevo_api_key
BREVO_API_TIMEOUT=10

# Browser push / VAPID keys for dashboard + web notifications
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key

# Optional integrations
ORDER_TRACKING_BASE_URL=https://your-app.railway.app/track
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
